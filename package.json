{
  "name": "dsh-douyin-export",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Download watermark-free Douyin videos, transcribe them with local or cloud ASR, proofread the transcript with AI terms, and export Markdown/TXT/SRT/VTT/JSON/HTML/DOCX.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "douyin",
    "transcript",
    "asr",
    "markdown"
  ],
  "author": "hangye.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hangyesite/dsh-douyin-export.git"
  },
  "homepage": "https://github.com/hangyesite/dsh-douyin-export#readme",
  "bugs": {
    "url": "https://github.com/hangyesite/dsh-douyin-export/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "server.js",
    "tasks.js",
    "skills.js",
    "action-cards.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "engine",
    "skills/**",
    "mcp/**",
    "scripts/selfcheck.mjs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/selfcheck.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
